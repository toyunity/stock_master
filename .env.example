# Stock Master 환경변수 예시 — `cp .env.example .env` 후 필요한 값만 채운다.
# ⚠️ 리포 루트에 이미 .env가 있으면 덮어쓰지 마라(실사용 키가 들어 있다).
#
# 전부 선택이다(키가 없으면 데모 모드로 뜬다). 접두사는 SM_ 고정(backend/config.py).
# ⚠️ .env는 .gitignore 대상이다. 이 예시 파일에는 값을 적지 마라.
#
# 규칙 두 개(둘 다 실제로 기동을 죽였다):
#  1) 빈 값은 '미설정'이 아니라 빈 문자열이다 — bool 항목은 키를 아예 주석 처리해 둔다.
#  2) 값 뒤에 `# 주석`을 붙이면 주석이 값의 일부로 읽힌다 — 설명은 항상 윗줄에.

# ── 데이터 원천 키 ────────────────────────────────────────────────
# KIS 오픈API(실시간 수급·시세·재무·선물·옵션). 둘 다 있으면 live, 없으면 데모.
# ⚠️ 1키 1세션 — 이 키로 뜬 서버가 하나뿐이어야 한다(둘째는 OPSP8996으로 영구 차단).
SM_KIS_APP_KEY=
SM_KIS_APP_SECRET=
# 토스증권 Open API(한국 국채 금리·대차거래·매수 유의사항 — KIS에 없는 것만).
# WTS(PC 웹) 로그인 > 설정 > Open API 에서 직접 발급. 승인 대기 없음.
# ⚠️ 토큰은 client당 1개다 — **재발급하면 이전 토큰이 즉시 무효화된다**(공식 스펙).
#    실서버와 검증서버가 같은 client_id를 쓰면, 한쪽이 토큰을 받는 순간 다른 쪽이
#    401로 죽는다. 검증용은 반드시 별도 client_id로 발급하거나 비워 둘 것.
# ⚠️ 같은 설정 화면의 '허용 IP 관리'에 이 서버의 공인 IP를 등록해야 한다.
#    미등록이면 토큰 발급부터 403이고, 웹소켓도 같은 목록을 쓴다.
# 비우면 토스 경로 전체가 꺼진다(한국 금리 칩·대차·유의사항만 사라지고 나머지는 정상).
SM_TOSS_CLIENT_ID=
SM_TOSS_CLIENT_SECRET=
# DART 공시(opendart.fss.or.kr에서 즉시 발급되는 40자 키). 비우면 공시만 비활성.
SM_DART_API_KEY=

# ── 실행 모드 ────────────────────────────────────────────────────
# ''=자동(키 있으면 live) | 'demo'=강제 데모(시드 랜덤워크, KIS 미접촉)
SM_FLOW_MODE=
# 코스피200 옵션 섹션. 한 회차 KIS 호출 최대 1,012건 — 유량 확인 후 켠다(기본 false).
# SM_OPTIONS_ENABLED=true

# ── 인증 게이트(공개 배포 시 필수) ────────────────────────────────
# fail-closed: SM_AUTH_ENABLED=true인데 아래 크리덴셜이 비면 앱이 기동을 거부한다.
# SM_AUTH_ENABLED=true
SM_GOOGLE_CLIENT_ID=
SM_GOOGLE_CLIENT_SECRET=
# 콤마 구분. Google OAuth 테스트 사용자 목록과는 별개다(둘 다 채워야 한다).
SM_ALLOWED_EMAILS=
# 공개 HTTPS 콜백. 로컬 검증은 localhost 콜백을 쓴다.
SM_OAUTH_REDIRECT_URL=
# 쿠키 Secure 플래그. 로컬 http 검증에서만 false로 내린다(기본 true).
# SM_COOKIE_SECURE=false
# 아래 둘은 미설정 시 캐시 디렉터리에 생성·영속된다(굳이 채울 필요 없음).
SM_SESSION_SECRET=
SM_TOTP_SECRET=

# ── 아이폰 위젯 / 계정 ───────────────────────────────────────────
# 20자 미만이면 create_app이 RuntimeError로 죽는다(약한 토큰이 유일 방어선이 되는 것 차단).
# 생성: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SM_WIDGET_TOKEN=
# 계정별 데이터 기준 이메일. 미설정 시 allowlist 첫 이메일.
SM_DEFAULT_ACCOUNT=
# 공개 배포 주소(Tailscale Funnel 등). `harness ops`의 공개 점검 대상 — 미설정이면 생략.
SM_PUBLIC_URL=

# ── 그 외(기본값으로 충분, 필요할 때만) ──────────────────────────
# SM_WATCHLIST, SM_CACHE_DIR, SM_HISTORY_DAYS, SM_MARKET_DIV(UN|J|NX),
# SM_STALL_SEC, SM_WATCH_LINES='{"000660":[{"price":100000,"label":"목표"}]}'
