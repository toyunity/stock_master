<?xml version="1.0" encoding="utf-8"?>
<!-- 토큰이 든 SharedPreferences(Prefs.kt "sm_widget")는 클라우드 백업·기기 이전 어느 쪽으로도 내보내지 않는다(스펙 §보안).
     WorkManager DB·Glance 상태엔 비밀이 없어 그대로 둔다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="sm_widget.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="sm_widget.xml" />
    </device-transfer>
</data-extraction-rules>
